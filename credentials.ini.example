# =============================================================================
# credentials.ini  –  EKG ETL credential store
# =============================================================================
#
# SECURITY
# ────────
# This file contains passwords in plain text.
# Restrict access immediately after creation:
#
#   chmod 600 credentials.ini          (Linux / macOS)
#   icacls credentials.ini /inheritance:r /grant:r "%USERNAME%:R"   (Windows)
#
# Never commit this file to version control.
# Add it to .gitignore:
#   echo "credentials.ini" >> .gitignore
#
# For production workloads prefer AWS Secrets Manager, Azure Key Vault,
# Google Secret Manager, or HashiCorp Vault.  Use this file for local
# development, CI environments without a cloud secrets provider, or as
# a fallback when cloud providers are unavailable.
#
# Chain position
# ──────────────
# The INI provider sits between cloud providers and environment variables:
#   EKG_SECRET_PROVIDERS=aws,vault,ini,env      # recommended for mixed envs
#   EKG_SECRET_PROVIDERS=ini,env                # local dev, no cloud
#
# File path resolution (first match wins)
# ────────────────────────────────────────
#   1. EKG_CREDENTIALS_FILE env var (explicit path)
#   2. ./credentials.ini            (current working directory)
#   3. ~/.ekg/credentials.ini       (user home directory)
#
# Format
# ──────
# Each section header must match the secret_ref value configured in
# DBConfig.secret_ref or GraphTargetConfig.options["secret_ref"].
#
# Supported keys per section:
#   username    (required)
#   password    (required)
#   host        (optional – overrides DBConfig.host)
#   port        (optional – overrides DBConfig.port)
#   dbname      (optional – overrides DBConfig.database)
#   endpoint    (optional – overrides graph target endpoint)
#   region      (optional – overrides cloud region)
#
# Any additional keys are passed through as-is and are available to
# whichever component resolves this ref.
# =============================================================================


# ---------------------------------------------------------------------------
# Meta database  (read-only PostgreSQL)
# Matches: meta_cfg.secret_ref = "prod/meta-db"
# ---------------------------------------------------------------------------
[prod/meta-db]
username = meta_user
password = change_me
host     = localhost
port     = 5432
dbname   = meta


# ---------------------------------------------------------------------------
# Run database  (read-write PostgreSQL)
# Matches: run_cfg.secret_ref = "prod/run-db"
# ---------------------------------------------------------------------------
[prod/run-db]
username = run_user
password = change_me
host     = localhost
port     = 5432
dbname   = run


# ---------------------------------------------------------------------------
# Graph target – AWS Neptune
# Matches: EKG_TARGET_SECRET_REF = "prod/ekg-target"
# The endpoint and IAM role are usually not credentials, but can be
# centralised here for convenience.
# ---------------------------------------------------------------------------
[prod/ekg-target-neptune]
# Neptune uses IAM authentication; username/password are not used.
# Set endpoint and iam_role_arn here or via env vars.
endpoint     = https://my-cluster.cluster-xxxx.eu-central-1.neptune.amazonaws.com:8182
iam_role_arn = arn:aws:iam::123456789012:role/NeptuneLoadFromS3


# ---------------------------------------------------------------------------
# Graph target – Neo4j
# ---------------------------------------------------------------------------
[prod/ekg-target-neo4j]
username = neo4j
password = change_me
endpoint = bolt://neo4j.internal:7687
dbname   = neo4j


# ---------------------------------------------------------------------------
# Graph target – Azure Cosmos DB (Gremlin)
# The "username" for Cosmos Gremlin is the path /dbs/<db>/colls/<graph>
# ---------------------------------------------------------------------------
[prod/ekg-target-cosmos]
username = /dbs/my-database/colls/my-graph
password = primary_key_here==
endpoint = wss://my-account.gremlin.cosmos.azure.com:443/


# ---------------------------------------------------------------------------
# Graph target – Google Spanner Graph
# Spanner uses Application Default Credentials; no username/password needed.
# Store project/instance/database here for convenience.
# ---------------------------------------------------------------------------
[prod/ekg-target-spanner]
project  = my-gcp-project
instance = my-spanner-instance
dbname   = my-spanner-database


# ---------------------------------------------------------------------------
# Additional source databases (business data)
# Add one section per data_source.secret_ref value in the meta database.
# ---------------------------------------------------------------------------
[prod/crm-db]
username = crm_readonly
password = change_me
host     = crm-db.internal
port     = 5432
dbname   = crm

[prod/erp-db]
username = erp_readonly
password = change_me
host     = erp-db.internal
port     = 1433
dbname   = erp_prod
